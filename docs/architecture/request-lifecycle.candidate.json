  "cards": [
    {
      "dot": "cyan",
      "title": "One gate, two token classes",
      "items": [
        "operator localToken — no ceiling; app tokens from the roster's router.apps",
        "unknown bearer → 401; every attempt carries its trigger: operator | app:<name>"
      ]
    },
    {
      "dot": "rose",
      "title": "Classify before bench",
      "items": [
        "usage-limit vocabulary is matched before the 429 pattern — a window hours away is quota, not rate",
        "quota, billing and rate bodies are never key faults; model gaps walk without benching",
        "bench order: roster override → Retry-After (honest cases) → classified bench → per-status floor"
      ]
    },
    {
      "dot": "emerald",
      "title": "Capability parity",
      "items": [
        "a fallback declaring it lacks images or tools (manualModelRules) is excluded before steering",
        "undeclared caps gate nothing — the neutrality law"
      ]
    },
    {
      "dot": "violet",
      "title": "Every attempt metered",
      "items": [
        "won, diverted, lost and parity-excluded attempts all land in the ledger",
        "cost comes from declared roster prices at record time — never estimated; no price, no cost",
        "the ledger feeds the dashboard, quota headroom and steering"
      ]
    }
  ]
